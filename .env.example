# Conexão Postgres (Neon, string "pooler", sem channel_binding)
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require
# Segredo para assinar a sessão (string longa e aleatória)
SESSION_SECRET=troque-por-um-segredo-longo
# Administrador criado na primeira migração
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
# Segredo do cron da Vercel (Authorization: Bearer ...)
CRON_SECRET=troque
# Integrações reais (vazias = modo demonstração)
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=codigo_verificacao
PIX_PROVIDER=
PIX_WEBHOOK_SECRET=
